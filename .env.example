# ─────────────────────────────────────────────────────────────────────────────
# .env.example — template for the real .env file.
#
# INSTRUCTIONS:
#   1. Copy this file to backend/.env — NOT the repo root: pydantic-settings loads ".env" relative to
#      the directory uvicorn runs from, so a root-level copy is silently ignored.
#        cp .env.example backend/.env
#   2. Replace every placeholder value with your real credentials.
#   3. The real .env is in .gitignore — never commit it.
#
# WHERE TO GET EACH KEY (see README.md "Getting your keys" section):
#   GROQ_API_KEY          → https://console.groq.com  (API Keys tab)
#   PINECONE_API_KEY      → https://app.pinecone.io   (API Keys tab)
#   PINECONE_INDEX_NAME   → name you choose; the app creates the index on first use
#   MONGODB_URI           → Atlas dashboard → Connect → Drivers (copy the URI)
#   JWT_SECRET            → run: openssl rand -hex 32
#   DEMO_ACCESS_CODE      → a code you invent; this is what visitors type
#   CORS_ORIGINS          → comma-separated, no spaces around commas
#   SMTP_USER / PASSWORD  → https://myaccount.google.com/apppasswords (App: Mail), only if you set
#                           MAIL_TRANSPORT=smtp
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ───────────────────────────────────────────────────────────────────────
# FREE-TIER NOTE: Groq free tier — check your per-model limits at
# console.groq.com/docs/rate-limits before designing retry strategy (Phase 5).
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional. Defaults to qwen/qwen3.8-27b. The llama-3.x models this project originally used are retired
# from Groq's catalogue, so this is the lever to pull when the next default ages out — no code change
# needed. Do NOT point it at a reasoning model (openai/gpt-oss-*): those bill hidden thinking tokens
# against max_tokens, and the router agent asks for 48, which leaves nothing for its actual answer and
# silently breaks document scoping. Check what your key can see with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=qwen/qwen3.8-27b

# ── Vector DB ─────────────────────────────────────────────────────────────────
# FREE-TIER NOTE: Pinecone Starter = 2 GB storage, 2M write units/month.
# Create a serverless index (AWS us-east-1) in the Pinecone console first.
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=documind-chunks

# ── Document DB ───────────────────────────────────────────────────────────────
# FREE-TIER NOTE: MongoDB Atlas M0 = 512 MB hard cap.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/documind?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32. Minimum 32 characters — the app refuses to boot below that,
# because HS256 keys shorter than that are weak and PyJWT warns on every signing call.
# Must be kept secret — anyone with this key can forge valid session tokens for any owner namespace.
JWT_SECRET=your_random_64_char_hex_secret_here

# The code a visitor types on the DocuMind front page to open a session. Publish it in the README so
# reviewers can use the demo; it is the price of entry, not an identity. Identity comes from the signed
# token this exchanges for, which is what stops a caller from naming someone else's owner id.
# Still required while /api/auth/session exists; the email + password endpoints below are what replaces it.
DEMO_ACCESS_CODE=pick-something-guessable-only-by-reading-your-readme

# How long a session token stays valid. A day suits a demo that nobody wants to re-auth every hour.
JWT_TTL_MINUTES=1440

# ── Accounts and mail ─────────────────────────────────────────────────────────
# The email + password flow that /api/auth/register, /verify, /resend and /login use. Leave these alone
# locally: MAIL_TRANSPORT=console is the default, the verification link is written to the log, and you can
# confirm an address without owning a mail account.

# "console" (default) writes the message to the log; "smtp" sends it. Anything else is refused at boot,
# because a typo like sendgrid silently falling back to console would put every visitor's verification
# link into the application log on a deployed instance.
# MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
# 465 is implicit TLS — the app uses smtplib.SMTP_SSL, not starttls, because that is what Gmail offers on
# this port.
SMTP_PORT=465
# The sending address. Gmail rejects a message whose From is not the authenticated account, so this is
# both the sender and the login.
# SMTP_USER=you@gmail.com
# A Gmail App Password from https://myaccount.google.com/apppasswords (App: Mail), NOT the account
# password. Google disabled raw account-password auth for this endpoint; an App Password is 16 characters
# with the spaces removed and can be revoked on its own. Setting MAIL_TRANSPORT=smtp with either of these
# blank is refused at boot, because the alternative is a service that appears healthy and never delivers.
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Where verification links point: the frontend origin. Do not derive it from the request — behind Render
# the Host header is the API's own domain and the link would send visitors to onrender.com.
# FRONTEND_BASE_URL=http://localhost:3000

# A verification link that never expires is a phishing forward; one that expires before the mail is read
# is a visitor who cannot get into their own account.
# VERIFICATION_TTL_MINUTES=1440

# ── Rate limits ───────────────────────────────────────────────────────────────
# Per owner (per minute), enforced in this process. They exist to protect the shared free-tier Groq and
# Pinecone budgets, which every visitor spends from the same pool.
CHAT_REQUESTS_PER_MINUTE=10
UPLOAD_REQUESTS_PER_MINUTE=6
# Keyed by client address rather than owner, because a login attempt has no owner id yet.
LOGIN_REQUESTS_PER_MINUTE=5
# Register and resend share this one, over an hour instead of a minute. The budget it protects is not CPU:
# it is rows in a 512 MB Atlas cluster and mails sent through one Gmail account, both of which accumulate
# slowly and would let a per-minute limit still permit hundreds of accounts an hour.
SIGNUP_REQUESTS_PER_HOUR=8

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: just localhost:3000.
# Production: add your Vercel URL, e.g. https://documind-ai.vercel.app
# Comma-separated, no wildcard (*) in production.
CORS_ORIGINS=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────
# Every value below has a working default in backend/app/core/config.py. Set one only to change
# behaviour — and leave ENVIRONMENT alone on a local machine.

# "development" (default) or "production". In production a request without a valid Bearer token is
# rejected outright; the X-Demo-Key fallback is accepted only outside it. Render sets this.
# ENVIRONMENT=production

# Version string reported by /api/health.
# APP_VERSION=0.1.0

# ── Ingestion tuning ──────────────────────────────────────────────────────────
# Chunk size and overlap are character counts, not tokens: the boundary is what stops an answer that
# spans a page break from being split into two unusable halves.
# CHUNK_MAX_CHARACTERS=1000
# CHUNK_OVERLAP_CHARACTERS=150

# Upload guards, enforced before a file reaches a parser.
# MAX_UPLOAD_BYTES=10485760
# ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt

# Owner id used by the non-production X-Demo-Key fallback when a request sends no key at all.
# DEFAULT_OWNER_ID=local-user

# ── Embeddings and index geometry ─────────────────────────────────────────────
# Changing EMBEDDING_MODEL_NAME means every previously stored vector is now meaningless: cosine between
# vectors from different models is noise. Recreate the Pinecone index (drop and re-upload) rather than
# switching in place — the app raises at load if the model's dimensions disagree with the index.
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# MONGO_DATABASE_NAME=documind

# ── Frontend (Next.js only — not read by FastAPI) ─────────────────────────────
# In Next.js, create a .env.local file inside the frontend/ directory
# (or set this in Vercel's dashboard) — do NOT put it in this root .env.
# NEXT_PUBLIC_ prefix makes it available in the browser bundle.
# NEXT_PUBLIC_API_URL=http://localhost:8000   ← for local dev
# NEXT_PUBLIC_API_URL=https://your-app.onrender.com   ← for production (set in Vercel dashboard)
